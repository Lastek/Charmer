CC = cl
CFLAGS = /EHsc /W3 /nologo
LIBS = ole32.lib setupapi.lib mf.lib mfplat.lib mfreadwrite.lib mfuuid.lib strmiids.lib
TARGET = enum_devs3.exe
SRC = enum_devs3.cpp

all: $(TARGET)

$(TARGET): $(SRC)
	$(CC) $(CFLAGS) /Fe:$(TARGET) $(SRC) /link $(LIBS)

clean:
	del /Q $(TARGET) *.obj 2>nul

.PHONY: all clean
